# ── kgsm-dns — host overrides ─────────────────────────────────────────────────
# Seeded once by deploy/setup.sh and never written again, so anything set here survives every
# redeploy. Every key the daemon reads is declared in kgsm-dns.settings.json beside the binary; a
# variable naming a key that is not declared there binds to nothing and sets nothing.
#
# The settings file beside the binary carries the cluster's own values — the zone, its id, the names
# nodes are drawn from. This file carries what belongs to one machine or is secret: the credential, and
# where this machine is reached. Without the credential this anchor holds the capability, says it is
# unconfigured, and publishes nothing.
#
# The cluster secret is NOT here. It is host-level, in /etc/kgsm/kgsm-cluster.env, because a machine
# can run more than one member and they all carry the same one.

# ── The credential ────────────────────────────────────────────────────────────
# The API token this anchor changes the zone with. The zone itself, its id, and the names nodes are
# drawn from are declared in kgsm-dns.settings.json; the token is the one thing that is not, because it
# is a secret and that file ships in the package. It is held by this member alone — the reason every
# other member asks this one for a name. A provider token scopes to a zone and not to a part of one, so
# a copy on another machine would be a copy of the whole zone.
#Dns__ProviderToken=

# ── Sign-in ───────────────────────────────────────────────────────────────────
# The provider whose tokens admit a person to this anchor's page is NOT set here. Sessions__Issuer and
# Sessions__Audience are host-level, in /etc/kgsm/kgsm-cluster.env beside the cluster secret, because
# every component on the machine admits people from the same provider.

# ── This machine ──────────────────────────────────────────────────────────────
# Where this machine is reached from the internet — normally the dynamic-DNS name its network already
# keeps pointed at a changing home address. The capability's name is a CNAME to it, so an address
# change moves nothing here. A fixed public address works too. Blank leaves the capability's name
# unpublished, which is honest — a name pointing at a guess is worse than a name that does not resolve.
#Dns__PublicHost=example.ddns.net

# The address other members reach this anchor at. A daemon behind a proxy sees only the loopback hop
# and cannot work this out for itself, so it is stated here, and it is what the cluster roster
# carries.
#Dns__PublicBaseUrl=https://dns.anchors.example.com

# ── Cadence ───────────────────────────────────────────────────────────────────
# How long other computers may remember an answer, and how often the zone is compared with what this
# anchor recorded.
#Dns__TtlSeconds=60
#Dns__ReconcileSeconds=300

# Minimum severity this anchor logs.
#Logging__LogLevel__Default=Information
