# kgsm-dns — how a request to the DNS anchor is handled, included by every server block the anchor
# generates for its own names in /var/lib/kgsm/nginx/kgsm-dns.conf.
#
# The generated blocks carry only a name and its certificate; everything about where a request goes is
# here, installed with the component and written by nothing at runtime.

# The member-to-member wire is capped by the cluster package itself. Nothing legitimate arrives here
# large.
client_max_body_size 1m;

location / {
    proxy_pass         http://127.0.0.1:8099;
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   Connection        '';
}
